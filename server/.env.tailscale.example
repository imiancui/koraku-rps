NODE_ENV=production
HOST=127.0.0.1
PORT=8080
TRUST_PROXY=true
ALLOWED_ORIGINS=https://<機器名>.<tailnet>.ts.net,https://koraku.app
BATTLE_LOCK_POLICY=always
STORAGE_DIR=./server/data
BACKUP_DIR=./server/backups
JWT_SECRET=<用 node -e "console.log(require('crypto').randomBytes(32).toString('hex'))" 產生>
ANON_SALT=<同上>
DEV_ADMIN_KEY=<同上>
